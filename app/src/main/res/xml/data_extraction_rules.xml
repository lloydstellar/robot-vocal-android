<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and songs only. The LA2L pairing token is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="robotvocal.xml" />
        <include domain="file" path="songs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="robotvocal.xml" />
        <include domain="file" path="songs/" />
    </device-transfer>
</data-extraction-rules>
